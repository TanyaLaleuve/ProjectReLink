<Window x:Class="ReLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project ReLink" Width="1120" Height="700" WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Shell}" Foreground="{StaticResource Bone}"
        FontFamily="{StaticResource Text}" FontSize="14.5" Icon="app.ico" AllowDrop="True" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <!-- The cartridge: the grey shell and its grooves; on the left the dark side (where to go, Play), on the right the cream label
       (one page at a time: Home, the options, the install and its steps, a problem) -->
  <Grid x:Name="Root" ClipToBounds="True" Background="{StaticResource Shell}">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>

    <!-- the grooves along the top, and the window's own buttons -->
    <Rectangle Height="7" Margin="260,0,260,0" VerticalAlignment="Center" RadiusX="2" RadiusY="2">
      <Rectangle.Fill>
        <DrawingBrush TileMode="Tile" Viewport="0,0,9,7" ViewportUnits="Absolute" Viewbox="0,0,9,7" ViewboxUnits="Absolute">
          <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource Groove}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,7"/></GeometryDrawing.Geometry></GeometryDrawing>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Rectangle.Fill>
    </Rectangle>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
      <Button x:Name="MinButton" Style="{StaticResource Chrome}" Click="Minimize">
        <Path Data="M0,0 L11,0" Stroke="{StaticResource Bone}" StrokeThickness="1.6" Margin="0,7,0,0"/>
      </Button>
      <Button x:Name="CloseButton" Style="{StaticResource Chrome}" Click="CloseWindow">
        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Bone}" StrokeThickness="1.6"/>
      </Button>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>

      <!-- the side: the name, where to go, what Play will do, Play -->
      <Border x:Name="LeftColumn" Background="{StaticResource Side}" CornerRadius="12" Margin="12,0,0,12" Padding="14,16,14,14">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Project ReLink" FontWeight="ExtraBold" FontSize="19" Foreground="{StaticResource SideText}" Margin="4,0,0,0"/>
            <TextBlock x:Name="Subtitle" FontSize="12.5" Foreground="{StaticResource SideSoft}" TextWrapping="Wrap" Margin="4,4,0,0"/>
            <StackPanel x:Name="NavPanel" Margin="0,20,0,0">
              <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True" Checked="NavChanged"/>
              <RadioButton x:Name="NavOptions" Style="{StaticResource Nav}" GroupName="Nav" Checked="NavChanged"/>
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <!-- exefs mods: the code patches in mods are not the ones the game was built with (ExefsMods.cs) -->
            <StackPanel x:Name="ModsRow" Margin="4,0,0,10" Visibility="Collapsed">
              <TextBlock x:Name="ModsText" FontSize="12.5" Foreground="{StaticResource SideSoft}" TextWrapping="Wrap"/>
              <Button x:Name="RebuildLink" Style="{StaticResource Link}" Foreground="{StaticResource Gold}" HorizontalAlignment="Left" Click="RebuildClick"/>
            </StackPanel>
            <StackPanel x:Name="StatusRow" Margin="4,0,0,10">
              <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource SideSoft}" TextWrapping="Wrap"/>
              <Button x:Name="UpdateLink" Style="{StaticResource Link}" Foreground="{StaticResource Gold}" HorizontalAlignment="Left" Visibility="Collapsed" Click="UpdateClick"/>
            </StackPanel>
            <TextBlock x:Name="MainNote" FontSize="12.5" Foreground="{StaticResource SideSoft}" TextWrapping="Wrap" Margin="4,0,0,10"/>
            <Button x:Name="MainButton" Style="{StaticResource Play}" Height="58" Click="MainClick">
              <TextBlock x:Name="MainButtonText" FontWeight="ExtraBold" FontSize="21" Foreground="White"/>
            </Button>
            <WrapPanel Margin="4,12,0,0">
              <Button x:Name="FolderLink" Style="{StaticResource Link}" Foreground="{StaticResource SideSoft}" FontSize="12.5" Margin="0,0,14,0" Click="OpenGameFolder"/>
              <Button x:Name="HelpLink" Style="{StaticResource Link}" Foreground="{StaticResource SideSoft}" FontSize="12.5" Margin="0,0,14,0" Click="OpenHelp"/>
              <Button x:Name="DiscordLink" Style="{StaticResource Link}" Foreground="{StaticResource SideSoft}" FontSize="12.5" Click="OpenDiscord"/>
            </WrapPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- the label: one page at a time -->
      <Border x:Name="Tablet" Grid.Column="1" Background="{StaticResource Label}" CornerRadius="12" Margin="10,0,12,12">
        <Grid Margin="20,16,20,14">

          <!-- Home: the sky over Hyrule at the player's hour, the staff with what the game needs, what Play will do -->
          <Grid x:Name="HeroView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Height="372">
              <Grid.Clip><RectangleGeometry Rect="0,0,844,372" RadiusX="10" RadiusY="10"/></Grid.Clip>
              <Canvas x:Name="Sky" Width="844" Height="372" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              <StackPanel Margin="24,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="Ocarina of Time" FontWeight="ExtraBold" FontSize="34" Foreground="{StaticResource StaffBone}"/>
                <TextBlock x:Name="HeroSub" FontSize="13.5" Foreground="{StaticResource StaffBone}" Opacity="0.85" Margin="2,2,0,0"/>
              </StackPanel>
              <Canvas x:Name="StaffCanvas" Width="424" Height="176" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,176,0,0"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="LooksCard" Background="#E5DECE" CornerRadius="10" Padding="14,10,14,10" Cursor="Hand" MouseLeftButtonDown="LooksClick">
                <StackPanel>
                  <TextBlock x:Name="LooksHead" FontSize="12.5" Foreground="{StaticResource BoneSoft}"/>
                  <TextBlock x:Name="LooksText" FontSize="14.5" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="LooksMore" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Red}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="MovesCard" Grid.Column="2" Background="#E5DECE" CornerRadius="10" Padding="14,10,14,10" Cursor="Hand" MouseLeftButtonDown="MovesClick">
                <StackPanel>
                  <TextBlock x:Name="MovesHead" FontSize="12.5" Foreground="{StaticResource BoneSoft}"/>
                  <TextBlock x:Name="MovesText" FontSize="14.5" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="MovesMore" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Yellow}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock x:Name="HeroFoot" Grid.Row="3" FontSize="12.5" Foreground="{StaticResource BoneFaint}" Margin="2,10,0,0"/>
          </Grid>

          <!-- install: the player's copy, and where the game goes -->
          <Grid x:Name="InstallView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Blue"/><StaticResource x:Key="AccentTint" ResourceKey="BlueTint"/><StaticResource x:Key="AccentEdge" ResourceKey="BlueEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{StaticResource Blue}"><TextBlock x:Name="InstallTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="InstallSub" Grid.Row="1" Style="{StaticResource Body}" Margin="2,10,0,0"/>
            <TextBlock x:Name="CopyHead" Grid.Row="2" Style="{StaticResource Section}" Margin="2,16,0,4"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="DumpList"/>
            </ScrollViewer>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,10,0,0">
              <Button x:Name="BrowseNupLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="BrowseNup"/>
              <Button x:Name="BrowseFoldersLink" Style="{StaticResource Link}" Click="BrowseFolders"/>
            </StackPanel>
            <TextBlock x:Name="OutHead" Grid.Row="5" Style="{StaticResource Section}" Margin="2,16,0,4"/>
            <Grid Grid.Row="6" Margin="2,0,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="OutPathText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <Button x:Name="OutChange" Grid.Column="1" Style="{StaticResource Link}" Margin="16,0,0,0" Click="BrowseOut"/>
            </Grid>
            <TextBlock x:Name="SpaceText" Grid.Row="7" Style="{StaticResource RowHint}" Margin="2,6,0,0"/>
            <TextBlock x:Name="ToolsNote" Grid.Row="8" Style="{StaticResource RowHint}" Foreground="{StaticResource Warn}" Margin="2,8,0,0" Visibility="Collapsed"/>
          </Grid>

          <!-- the install at work: how far it is, its steps one a row, the one at work marked -->
          <Grid x:Name="BuildView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Green"/><StaticResource x:Key="AccentTint" ResourceKey="GreenTint"/><StaticResource x:Key="AccentEdge" ResourceKey="GreenEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{StaticResource Green}"><TextBlock x:Name="BuildTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="BuildSub" Grid.Row="1" Style="{StaticResource Body}" Foreground="{StaticResource BoneFaint}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Grid x:Name="ProgressBlock" Grid.Row="2" Margin="2,8,0,10" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PercentText" Text="0 %" FontWeight="ExtraBold" FontSize="46" VerticalAlignment="Center"/>
              <TextBlock x:Name="BuildNote" Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="22,0,0,0"/>
            </Grid>
            <StackPanel x:Name="StageList" Grid.Row="3"/>
            <TextBox x:Name="Log" Grid.Row="3" Visibility="Collapsed" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="11.5"
                     Background="#E5DECE" Foreground="{StaticResource HelpInk}" BorderThickness="0" Padding="10" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,12,0,0">
              <Button x:Name="LogLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="LogToggled"/>
              <Button x:Name="CancelLink" Style="{StaticResource Link}" Foreground="{StaticResource BoneSoft}" Click="CancelBuild"/>
            </StackPanel>
          </Grid>

          <!-- the game is ready -->
          <Grid x:Name="ReadyView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Green"/><StaticResource x:Key="AccentTint" ResourceKey="GreenTint"/><StaticResource x:Key="AccentEdge" ResourceKey="GreenEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{StaticResource Green}"><TextBlock x:Name="ReadyTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="ReadyNote" Grid.Row="1" Style="{StaticResource Body}" Margin="2,10,0,10"/>
            <StackPanel x:Name="ReadyRows" Grid.Row="2"/>
            <Button x:Name="ReadySettings" Grid.Row="3" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="2,18,0,0" Click="ReadyToHome"/>
          </Grid>

          <!-- something went wrong -->
          <Grid x:Name="ProblemView" Visibility="Collapsed">
            <Grid.Resources>
              <StaticResource x:Key="Accent" ResourceKey="Red"/><StaticResource x:Key="AccentTint" ResourceKey="RedTint"/><StaticResource x:Key="AccentEdge" ResourceKey="RedEdge"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Strip}" Background="{StaticResource Red}"><TextBlock x:Name="ProblemTitle" Style="{StaticResource ViewTitle}"/></Border>
            <TextBlock x:Name="ProblemSub" Grid.Row="1" Style="{StaticResource Body}" Margin="2,10,0,0"/>
            <TextBlock x:Name="ProblemHead" Grid.Row="2" Style="{StaticResource Section}" Margin="2,16,0,4"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="2,0,0,0">
                <TextBlock x:Name="ProblemText" Style="{StaticResource Body}" Foreground="{StaticResource Bone}"/>
                <StackPanel x:Name="ProblemSteps" Margin="0,10,0,0"/>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,14,0,0">
              <Button x:Name="BackLink" Style="{StaticResource Link}" Foreground="{StaticResource BoneSoft}" Margin="0,0,22,0" Click="Back"/>
              <Button x:Name="RepairLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="Repair"/>
              <Button x:Name="DetailsLink" Style="{StaticResource Link}" Margin="0,0,22,0" Click="ProblemShowDetails"/>
              <Button x:Name="CopyLink" Style="{StaticResource Link}" Click="CopyForReport"/>
            </StackPanel>
          </Grid>

          <!-- the options: the in-game menu's layout, a page a colour (Home.cs makes the rows) -->
          <Grid x:Name="HomeView" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <UniformGrid Rows="1" Columns="4" Height="42" Margin="-8,-4,-8,0">
              <RadioButton x:Name="TabDisplay" Style="{StaticResource Tab}" Background="{StaticResource Red}" GroupName="Tabs" IsChecked="True" Checked="TabChanged"/>
              <RadioButton x:Name="TabSmooth" Style="{StaticResource Tab}" Background="{StaticResource Yellow}" Foreground="{StaticResource Bone}" GroupName="Tabs" Checked="TabChanged"/>
              <RadioButton x:Name="TabGame" Style="{StaticResource Tab}" Background="{StaticResource Green}" GroupName="Tabs" Checked="TabChanged"/>
              <RadioButton x:Name="TabControls" Style="{StaticResource Tab}" Background="{StaticResource Blue}" GroupName="Tabs" Checked="TabChanged"/>
            </UniformGrid>
            <Grid Grid.Row="1" Margin="0,8,0,0">
              <ScrollViewer x:Name="PageDisplay" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources><StaticResource x:Key="Accent" ResourceKey="Red"/><StaticResource x:Key="AccentTint" ResourceKey="RedTint"/><StaticResource x:Key="AccentEdge" ResourceKey="RedEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsDisplay" Margin="0,0,10,0"/>
              </ScrollViewer>
              <ScrollViewer x:Name="PageSmooth" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ScrollViewer.Resources><StaticResource x:Key="AccentOn" ResourceKey="Bone"/><StaticResource x:Key="Accent" ResourceKey="Yellow"/><StaticResource x:Key="AccentTint" ResourceKey="YellowTint"/><StaticResource x:Key="AccentEdge" ResourceKey="YellowEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsSmooth" Margin="0,0,10,0"/>
              </ScrollViewer>
              <ScrollViewer x:Name="PageGame" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ScrollViewer.Resources><StaticResource x:Key="Accent" ResourceKey="Green"/><StaticResource x:Key="AccentTint" ResourceKey="GreenTint"/><StaticResource x:Key="AccentEdge" ResourceKey="GreenEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsGame" Margin="0,0,10,0"/>
              </ScrollViewer>
              <ScrollViewer x:Name="PageControls" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ScrollViewer.Resources><StaticResource x:Key="Accent" ResourceKey="Blue"/><StaticResource x:Key="AccentTint" ResourceKey="BlueTint"/><StaticResource x:Key="AccentEdge" ResourceKey="BlueEdge"/></ScrollViewer.Resources>
                <StackPanel x:Name="RowsControls" Margin="0,0,10,0"/>
              </ScrollViewer>
            </Grid>
            <!-- what the selected row does: in a box of its own under the rows, as the in-game menu has it (the rows keep one height) -->
            <Border x:Name="OptionsHelp" Grid.Row="2" BorderThickness="3,0,0,0" BorderBrush="{StaticResource Red}" Padding="12,2,8,2" Margin="8,10,8,0" Height="62">
              <TextBlock x:Name="OptionsHelpText" FontSize="13" LineHeight="18" Foreground="{StaticResource HelpInk}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HomeFoot" Grid.Row="3" Style="{StaticResource RowHint}" Foreground="{StaticResource BoneFaint}" Margin="12,8,0,0"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- while the game runs: the cartridge is in, a small label says so -->
    <Grid x:Name="PlayingOverlay" Grid.Row="1" Background="{StaticResource Shell}" Visibility="Collapsed">
      <Border Background="{StaticResource Label}" CornerRadius="12" Padding="40,30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
        <StackPanel>
          <Border Style="{StaticResource Strip}" Background="{StaticResource Green}" HorizontalAlignment="Center">
            <TextBlock x:Name="PlayingTitle" Style="{StaticResource ViewTitle}" FontSize="24"/>
          </Border>
          <TextBlock x:Name="PlayingHint" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,14,0,0"/>
          <Button x:Name="RestoreNow" Style="{StaticResource Link}" Foreground="{StaticResource Green}" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="RestoreNowClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
